# =========================================================================
# RGMCET Faculty Selection Portal - Environment Configuration
# =========================================================================

PORT=5000
JWT_SECRET=super-secret-jwt-key-rgmcet

# =========================================================================
# Automatic Faculty Selection Confirmation Email (SMTP Settings)
# =========================================================================
# When configured, the system dispatches real HTML confirmation emails
# directly to the student's registered college email upon course confirmation.
# If left empty, emails are safely simulated and tracked in the database.
#
# Example configuration for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-college-email@rgmcet.edu.in
# SMTP_PASS=your-google-app-password
# SMTP_FROM="RGMCET Faculty Selection Portal <no-reply@rgmcet.edu.in>"
#
# Example configuration for Custom College Mail Server / Exchange:
# SMTP_HOST=mail.rgmcet.edu.in
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@rgmcet.edu.in
# SMTP_PASS=secretpassword
# SMTP_FROM="RGMCET Academic Cell <admin@rgmcet.edu.in>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RGMCET Faculty Selection Portal <no-reply@rgmcet.edu.in>"
